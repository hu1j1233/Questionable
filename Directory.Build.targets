<Project>
    <PropertyGroup Condition="$(MSBuildProjectName) != 'GatheringPathRenderer'">
        <!-- Keep the local plugin version independent from upstream Questionable releases. -->
        <Version>2026.7.17.1</Version>
        <!-- Human-facing GitHub release tag for this local build. -->
        <ReleaseVersion>2026.7.17.1</ReleaseVersion>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);MSB3277;CA1506</NoWarn>
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277;CA1506</MSBuildWarningsAsMessages>
    </PropertyGroup>
</Project>
