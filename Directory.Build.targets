<Project>
    <PropertyGroup Condition="$(MSBuildProjectName) != 'GatheringPathRenderer'">
        <!-- Dalamud/NuGet versions are limited to four numeric components. -->
        <Version>15.306.0.9</Version>
        <!-- Human-facing GitHub release tag for this build. -->
        <ReleaseVersion>15.306.0.8.1</ReleaseVersion>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);MSB3277;CA1506</NoWarn>
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277;CA1506</MSBuildWarningsAsMessages>
    </PropertyGroup>
</Project>
